# Copiar a .env (nunca commitear). Los secretos viven solo en variables de entorno.
GROQ_API_KEY=
TAVILY_API_KEY=
# Supabase > Connect > Session pooler. Usuario: asistente_bot.<project-ref> (rol de mínimos privilegios)
DATABASE_URL=
DISCORD_TOKEN=

# ID numérico (no el username): Discord > modo desarrollador > clic derecho en tu perfil > Copiar ID
DISCORD_OWNER_ID=
DISCORD_GUILD_ID=
# Canales permitidos, separados por coma
DISCORD_CHANNEL_IDS=

# Canal (uno de los de arriba) donde el heartbeat publica avisos y recordatorios. Sin él, no avisa.
DISCORD_CANAL_AVISOS_ID=

# Canal (uno de los de arriba) para el vigía de temas (#vigia-temas). Sin él, el vigía no corre.
DISCORD_CANAL_VIGIA_ID=

TIMEZONE=America/Santiago

# Opcional. Modelos de respaldo, en orden, separados por coma. Cada uno tiene su propio cupo
# diario en Groq, así que cada uno agregado es cupo extra, no solo tolerancia a fallos.
# Por defecto: openai/gpt-oss-20b,qwen/qwen3.8-27b
# MODELOS_RESPALDO=
